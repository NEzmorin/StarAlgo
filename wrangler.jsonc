{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "staralgo-api",
  "main": "worker.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "staralgo-db",
      "database_id": "000ce601-434d-4436-8de8-6b1975009edb"
    }
  ],
  "ratelimits": [
    {
      "name": "API_EDGE_LIMITER",
      "namespace_id": "8100801",
      "simple": {
        "limit": 1200,
        "period": 60
      }
    },
    {
      "name": "AUTH_EDGE_LIMITER",
      "namespace_id": "8100802",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "SCRATCH_PROXY_LIMITER",
      "namespace_id": "8100803",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://staralgo.vercel.app"
  },
  "triggers": {
    "crons": [
      "0 4 * * *"
    ]
  }
}
